<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- mycelium:// deep links (invite / channel / conv). Used by
                 notification tap intents and external links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mycelium" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Default icon/color FCM uses for notifications shown automatically
             when the app is in the background or killed (no JS involved). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_mycelium" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Custom FCM handler. Declared here (app manifest) so it takes
             precedence over the Capacitor push plugin's service and receives
             our data-only messages, letting us attach the inline reply action.
             Handles all app states (foreground / background / killed). -->
        <service
            android:name="dev.carbonlab.mycelium.app.MyceliumMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Handles the inline "Reply" RemoteInput from message notifications. -->
        <receiver
            android:name="dev.carbonlab.mycelium.app.NotificationReplyReceiver"
            android:exported="false" />

        <!-- Remove the Capacitor push plugin's FCM service so OURS is the only
             handler for MESSAGING_EVENT. Otherwise FCM may dispatch to the
             plugin's service (which doesn't render our data-only messages,
             icon, threading, or reply). Initial token still works via the
             plugin's getToken(); refreshes are handled in our onNewToken(). -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33) to display notifications at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
