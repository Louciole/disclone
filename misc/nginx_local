server {
    listen 808;

    location /static/ {
        autoindex off;
        root [PATH];
    }

    location / {
        client_max_body_size 100M;
        proxy_set_header Host $host;
        proxy_pass "http://127.0.0.1:[SERV-PORT]";
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_request_buffering off;
    }
}