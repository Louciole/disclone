server{
    listen 80;
    listen 443;
    server_name hello.carbonlab.dev;

    location /static/ {
        autoindex off;
        root [PATH];
    }

    location / {
        proxy_set_header Host $host;
        proxy_pass "http://127.0.0.1:[SERV-PORT]";
        proxy_redirect off;
    }
}

server{
    listen 80;
    listen 443;
    server_name ws2.carbonlab.dev;
    location / {
        proxy_set_header Host $host;
        proxy_pass "http://127.0.0.1:[WS-PORT]";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_redirect off;
    }
}
